{
  "$defs": {
    "Channel": {
      "enum": [
        "whatsapp",
        "sms",
        "telegram",
        "slack",
        "teams",
        "fake"
      ],
      "title": "Channel",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A message as parsed by a channel adapter. Cloud-only (holds PII).",
  "properties": {
    "channel": {
      "$ref": "#/$defs/Channel"
    },
    "message_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "reply_to_message_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reply To Message Id"
    },
    "sender_address": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Sender Address",
      "type": "string"
    },
    "text": {
      "default": "",
      "maxLength": 4096,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "channel",
    "message_id",
    "sender_address",
    "received_at"
  ],
  "title": "InboundEvent",
  "type": "object"
}
